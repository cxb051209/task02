<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/tab1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintEnd_toStartOf="@id/tab2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/desc_space_station"
            android:src="@drawable/space_station_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_space_stations"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="@id/tab1"
        app:layout_constraintEnd_toStartOf="@id/tab3"
        app:layout_constraintStart_toEndOf="@id/tab1"
        app:layout_constraintTop_toTopOf="@id/tab1">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/desc_rocket"
            android:src="@drawable/rocket_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_flights"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="@id/tab1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tab2"
        app:layout_constraintTop_toTopOf="@id/tab1">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/desc_rover"
            android:src="@drawable/rover_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_rovers"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/tabDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab1" />

    <TextView
        android:id="@+id/tvDCA"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_margin="48dp"
        android:layout_marginTop="10dp"
        android:background="#1E5B3E"
        android:gravity="center"
        android:text="@string/label_dca"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/tvMARS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabDivider" />

    <TextView
        android:id="@+id/tvMARS"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginEnd="48dp"
        android:background="#1E5B3E"
        android:gravity="center"
        android:text="@string/label_mars"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/tvDCA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvDCA"
        app:layout_constraintTop_toTopOf="@id/tvDCA" />

    <ImageView
        android:id="@+id/ivSwap"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:contentDescription="@string/desc_swap"
        android:elevation="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/double_arrows"
        app:layout_constraintBottom_toBottomOf="@id/tvDCA"
        app:layout_constraintEnd_toStartOf="@id/tvMARS"
        app:layout_constraintStart_toEndOf="@id/tvDCA"
        app:layout_constraintTop_toTopOf="@id/tvDCA" />

    <TextView
        android:id="@+id/tvOneWay"
        android:layout_width="150dp"
        android:layout_height="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:background="#C2672A"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/label_one_way"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDCA" />

    <View
        android:id="@+id/vDot1"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/circle_white"
        app:layout_constraintBottom_toBottomOf="@id/tvOneWay"
        app:layout_constraintEnd_toEndOf="@id/tvOneWay"
        app:layout_constraintTop_toTopOf="@id/tvOneWay" />

    <TextView
        android:id="@+id/tvTraveller"
        android:layout_width="120dp"
        android:layout_height="36dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:background="#C2672A"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/label_traveller"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOneWay" />

    <ImageView
        android:id="@+id/ivGalaxy"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="@string/desc_galaxy"
        android:scaleType="fitCenter"
        android:src="@drawable/galaxy"
        app:layout_constraintBottom_toTopOf="@id/btnDepart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTraveller"
        app:layout_constraintVertical_bias="0.49" />

    <ImageView
        android:id="@+id/ivSmallRocket"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/desc_rocket"
        android:scaleType="fitCenter"
        android:src="@drawable/rocket_icon"
        app:layout_constraintBottom_toBottomOf="@id/ivGalaxy"
        app:layout_constraintEnd_toStartOf="@id/ivGalaxy"
        app:layout_constraintTop_toTopOf="@id/ivGalaxy" />

    <Button
        android:id="@+id/btnDepart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:backgroundTint="#1F5F3F"
        android:text="@string/btn_depart"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>